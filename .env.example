# Root directory for the database, binaries, and media
# MEMEVAULTPROJECT_DATA_DIR=~/.memevaultproject

# Where downloaded and uploaded files are saved
# MEMEVAULTPROJECT_DOWNLOAD_PATH=

# Custom binary paths (empty = auto-managed under DATA_DIR/bin)
# MEMEVAULTPROJECT_YTDLP_BIN=
# MEMEVAULTPROJECT_GALLERYDL_BIN=
# MEMEVAULTPROJECT_FFMPEG_BIN=

# Extra CLI flags
# MEMEVAULTPROJECT_YTDLP_EXTRA_ARGS=
# MEMEVAULTPROJECT_GALLERYDL_EXTRA_ARGS=

# Log verbosity: error, warn, info, debug
MEMEVAULTPROJECT_LOG_LEVEL=info

# Base URL used in share link OG embeds
# MEMEVAULTPROJECT_SHARE_BASE_URL=https://memes.example.com

# Legacy single API key (read_write). Prefer Settings → API keys.
# MEMEVAULTPROJECT_API_KEY=

# Optional OIDC (all three required to enable)
# MEMEVAULTPROJECT_OIDC_ISSUER=
# MEMEVAULTPROJECT_OIDC_CLIENT_ID=
# MEMEVAULTPROJECT_OIDC_CLIENT_SECRET=
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000

# Listen address (default 0.0.0.0:3000)
# MEMEVAULTPROJECT_BIND=0.0.0.0:3000
